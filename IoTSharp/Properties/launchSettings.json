{
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:60410/",
      "sslPort": 44314
    }
  },
  "profiles": {
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy"
      }
    },
    "Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_HOSTINGSTARTUPASSEMBLIES": "Microsoft.AspNetCore.SpaProxy",
        "Security__Authentication__Mode": "Local",
        "Security__Authorization__Mode": "Local",
        "Security__LocalUserManagementMode": "Enabled",
        "Security__ResourceSync__Enabled": "false",
        "Security__DataProtection__UseLocalKeys": "true"
      },
      "applicationUrl": "http://localhost:5202"
    },
    "MySql": {
      "commandName": "Project",
      "launchBrowser": true,
